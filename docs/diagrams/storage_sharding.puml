@startuml
allow_mixing
!theme plain
skinparam rectangle {
  shadowing false
  borderRadius 10
}
skinparam database {
  shadowing false
}

class "ConcurrentStorageDecorator" as Decorator

package "IStorageBackend Implementations" {
  class "SingleShardHandler" as Single {
    +getLock(key)
  }
  class "MultiShardHandler" as Multi {
    +getLock(key)
  }
}

package "Storage Nodes" {
    class "StorageNode" as Node1 {
        - lock
        - data
    }
    database "Shard 1" as DB1
    database "Shard 2" as DB2
    database "Shard N" as DBN
}


Decorator --> Single : (wraps)
Decorator --> Multi : (wraps)

Single --> Node1 : Manages
Multi --> Node1 : Manages
Multi --> DB1 : (routes to)
Multi --> DB2 : (routes to)
Multi --> DBN : (routes to)

note right of Decorator
  The *same* decorator works for both
  single and multi-shard configurations.
  It asks the handler for the correct lock.
end note

@enduml